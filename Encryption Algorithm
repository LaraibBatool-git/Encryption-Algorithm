#function to keep capital letters capital and vice versa
def get_base(ch):
    if ch.isupper():
        return ord('A')
    return ord('a')

#Ceaser Cipher
def ceaser_cipher(text, shift):
    result=[]               #collect new letters
    for ch in text:         #loop over each character of the provided text
        if ch.isalpha():    #chech for letters only
            base = get_base(ch)
            position = ord(ch) - base
            new_pos = (position + shift) % 26
            result.append(chr(new_pos + base))
        else:
            result.append(ch)
    return "".join(result)   #join list into one string

def ceaser_encrypt(text, key):
    return ceaser_cipher(text, key)

def ceaser_decrypt(text, key):
    return ceaser_cipher(text, -key)

#Atbash cipher
def atbash_cipher(text):
    result=[]
    for ch in text:
        if ch.isalpha():
            base = get_base(ch)
            position = ord(ch) - base
            new_pos = 25 - position
            result.append(chr(new_pos + base))
        else:
            result.append(ch)
    return "".join(result)

def atbash_encrypt(text):
    return atbash_cipher(text)

def atbash_decrypt(text):
    return atbash_cipher(text)

#Vigenere cipher
def clean_key(key):
    letters=[]
    for ch in key:
        if ch.isalpha():
            letters.append(ch.islower())
    return letters

def vigenere_cipher(text, key, decrypt=False):
    key_letters = clean_key(key)
    if key == 0:
        raise ValueError("Invalid key! Key must have atleast one letter")

    result = []
    key_index = 0         #tell which letter of key is being used

    for ch in text:
        if ch.isalpha():
            base = get_base(ch)
            shift = ord(key_letters[key_index % len(key_letters)]) - ord('a')
            if decrypt:
                shift = -shift
            position = ord(ch) - base
            result.append(chr((position + shift) % 26 + base))
            key_index+=1
        else:
            result.append(ch)
    return "".join(result)

def vigenere_encypt(text, key):
    return vigenere_cipher(text, key)

def vigenere_decrypt(text, key):
    return vigenere_cipher(text, key, decrypt=True)

